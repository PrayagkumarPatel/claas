# Copy to .env (gitignored) and fill in — loaded automatically by ./run.sh.
#
# Server-side credentials for the engine's Supabase mirror.
# Use the SERVICE ROLE key here (Supabase -> Settings -> API) — this file
# stays on your machine and is never exposed to a browser.
# The engine also runs fine with these unset (pure in-memory mode).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=your-service-role-key

# Set to 'cancel' to wipe all open orders at boot (cleans stale/crossed
# books left by crashes). Default: read-only bootstrap.
# CLAAS_DB_BOOTSTRAP=cancel
