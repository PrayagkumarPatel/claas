# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Stray virtual environment created AT the repo root ---
# (python3 -m venv . manifests as bin/ lib/ include/ pyvenv.cfg —
#  invisible to the .venv/ rules above)
/bin/
/include/
/lib/
/pyvenv.cfg

# --- Local tool config ---
.impeccable/

# --- Secrets & environment (NEVER commit these) ---
.env
.env.*
!.env.example

# --- Local agent/tooling configs (impeccable, cursor, etc. — machine-local) ---
.agent/
.claude/
.cursor/
.gemini/
.hermes/
.opencode/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Frontend (if it ever grows a build step) ---
node_modules/
dist/

# never commit nested copies or build output
claas_mvp/
.next/
